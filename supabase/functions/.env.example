# Copy to supabase/functions/.env for local `supabase functions serve` testing.
# In production this is never read from a file — set it with:
#   supabase secrets set GEMINI_API_KEY=your-real-key
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest

# CLOVA OCR (General) — used by analyze-contract to find and black out PII before an uploaded
# contract image is sent to Gemini. Free tier: 100 calls/month.
CLOVA_OCR_INVOKE_URL=your-clova-ocr-invoke-url
CLOVA_OCR_SECRET_KEY=your-clova-ocr-secret-key
